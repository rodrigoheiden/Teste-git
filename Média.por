programa {
  funcao inicio() {
    real N1, N2, N3, media

    escreva("Digite a primeira nota ")
    leia(N1)
    escreva("Digite a segunda nota ")
    leia(N2)
    escreva("Digite a terceira nota ")
    leia(N3)

   media=(N1+N2+N3)/3

   escreva("a sua media anual e" ,media,".\n")

   se(media>=8){
    escreva("bah, e um Alberto Eustenio. \n")
   }senao se(media<=6){
    escreva("mo burro kkkkkk \n")
   }

  }
}
